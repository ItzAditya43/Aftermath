# Local-only provider credentials. Copy to .env and fill in locally.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Provider requests are cached by prompt hash to conserve free-tier quotas.
AFTERMATH_LLM_CACHE=1
AFTERMATH_LLM_TIMEOUT_SECONDS=30

# --- Backend API (app/) ---
# mock = built-in fake agent (no keys needed); real = app/agent/real_agent.py
AGENT_MODE=mock
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=aftermath-incidents
DATABASE_URL=sqlite:///./aftermath.db
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
# Seed the demo data on startup when the database is empty
AUTO_SEED=false
# Delay between streamed tokens from the mock agent
MOCK_TOKEN_DELAY_MS=30
