# --- Intelligence engine / AI providers (aftermath_intelligence, used when AGENT_MODE=real) ---
# Provider chain: primary, then comma-separated fallbacks (groq | gemini | ollama).
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional local/self-hosted fallback (OpenAI-compatible endpoint, no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gpt-oss:120b-cloud

AFTERMATH_LLM_TIMEOUT_SECONDS=30
AFTERMATH_LLM_MAX_RETRIES=2
# In-memory response cache (set AFTERMATH_CACHE_DIR to also cache on disk)
AFTERMATH_LLM_CACHE=1
# Per-investigation limits
AFTERMATH_MAX_LLM_CALLS=3
AFTERMATH_INVESTIGATION_SECONDS=45
# Durable local incident memory + calibration (not Hindsight). Empty string = process-only.
AFTERMATH_MEMORY_PATH=.aftermath/memory.jsonl
AFTERMATH_CALIBRATION_PATH=.aftermath/calibration.jsonl
# Read-only diagnostic connectors (never start/stop/exec anything)
AFTERMATH_DOCKER_TOOLS=0
DOCKER_SOCKET=/var/run/docker.sock
# Change correlation: default repo and/or per-service repos (svc=owner/repo,...)
GITHUB_REPO=
AFTERMATH_SERVICE_REPOS=
# Optional for public repos; use a fine-grained read-only token
GITHUB_TOKEN=
# Set to 1 to run tests/test_live_providers.py against real APIs (spends tokens)
AFTERMATH_LIVE_TESTS=0

# --- Backend API (app/) ---
# mock = built-in fake agent (no keys needed); real = app/agent/real_agent.py
AGENT_MODE=mock
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=aftermath-incidents
DATABASE_URL=sqlite:///./aftermath.db
# Comma-separated list of allowed browser origins
FRONTEND_ORIGIN=http://localhost:3000
# Seed the demo data on startup when the database is empty
AUTO_SEED=false
# Delay between streamed tokens from the mock agent
MOCK_TOKEN_DELAY_MS=30
