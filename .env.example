# Local-only provider credentials. Copy to .env and fill in locally.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Provider requests are cached by prompt hash to conserve free-tier quotas.
AFTERMATH_LLM_CACHE=1
AFTERMATH_LLM_TIMEOUT_SECONDS=30
